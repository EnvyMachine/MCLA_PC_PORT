+// vpkd3d128 FLOAT16: float -> Xenos half (no inf/NaN: saturates to 0x7FFF, flushes
+// denormals). FLOAT16_4 rounds to nearest even, FLOAT16_2 truncates (as Xenia).
+inline uint16_t PPCFloatToXenosHalf(uint32_t bits, bool roundToNearestEven)
+{
+    uint32_t absValue = bits & 0x7FFFFFFFu;
+    uint32_t result;
+    if (absValue >= 0x47FFE000u)
+        result = 0x7FFFu;
+    else
+    {
+        result = absValue < 0x38800000u ? 0u : absValue + 0xC8000000u;
+        if (roundToNearestEven)
+            result += 0xFFFu + ((result >> 13u) & 1u);
+        result = (result >> 13u) & 0x7FFFu;
+    }
+    return uint16_t(result | ((bits & 0x80000000u) >> 16u));
+}
+
+// mftb. Projects can define this to return ticks of the guest's timebase frequency.
+#ifndef PPC_QUERY_TIMEBASE
+#define PPC_QUERY_TIMEBASE() __rdtsc()
+#endif
+
 #endif
